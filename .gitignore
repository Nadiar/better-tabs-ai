# Chrome Extension Development .gitignore

# Copilot Context (auto-generated)
.copilot/

# Node modules (if using build tools)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist/
build/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp

# Package files
*.crx
*.pem
*.zip

# Environment variables
.env
.env.local
.env.development
.env.test
.env.production

# Cache directories
.cache/
.parcel-cache/

# Test coverage
coverage/

# Extension store artifacts
web-ext-artifacts/

# Backup files
*.bak
*.backup

# Development and planning documents (keep only README.md and CHANGELOG.md)
*.md
!README.md
!CHANGELOG.md
!DEVELOPMENT.md
!copilot-prompt-template.md

REFACTOR_PLAN.md
REFACTOR_DECISIONS.md
TEST_RESULTS.md
STATUS.md

# Claude AI context files (auto-generated)
.claude/
archive/

# Testing artifacts (not test source files)
test-*.html
test-results/
playwright-report/

# Temporary and diagnostic files
*temp*
*diagnostic*
performance_test_results.txt

# Development artifacts
*.orig

# Explicitly allow copilot-prompt-template.md
!copilot-prompt-template.md